{
	"name": "discord-translate-bot",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "wrangler dev",
		"deploy": "wrangler deploy",
		"register": "tsx scripts/register-commands.ts",
		"test": "vitest run",
		"lint": "biome check .",
		"format": "biome format --write .",
		"check": "tsc --noEmit && tsc --noEmit -p tsconfig.scripts.json"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.15",
		"@cloudflare/vitest-plugin": "^1.3.5",
		"@cloudflare/workers-types": "^5.20260930.1",
		"@types/node": "^26.6.4",
		"tsx": "^4.23.15",
		"typescript": "^7.0.2",
		"vitest": "^5.0.3",
		"wrangler": "^4.144.0"
	},
	"allowScripts": {
		"workerd@1.20260926.1": true,
		"esbuild@0.28.1": true
	}
}
