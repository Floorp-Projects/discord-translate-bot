/**
 * Cloudflare Workers 設定
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "discord-translate-bot",
	"main": "src/index.ts",
	// 2025-09-01 では Secure Curves (Ed25519) がデフォルトで有効
	"compatibility_date": "2025-09-01",
	"ai": { "binding": "AI" },
	"kv_namespaces": [
		// 本番時は `npx wrangler kv namespace create translate-kv` で作成した実 ID に置き換えること
		{ "binding": "KV", "id": "7fd9dae3c1644abc8810abfbdfccf961" }
	],
	// Secret は vars に書かず `npx wrangler secret put <NAME>` で設定する:
	// - DISCORD_TRANSLATE_BOT_PUBLIC_KEY: 署名検証用
	// - DISCORD_BOT_TOKEN: /translate-send のチャンネル webhook 作成・一覧取得用
	//   (メッセージ送信には使わない。未設定なら bot 名義フォールバックで動作する)
	"vars": { "DISCORD_APP_ID": "1554801967526576189" },
	"observability": { "enabled": true }
}
